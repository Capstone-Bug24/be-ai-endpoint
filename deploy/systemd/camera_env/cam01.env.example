# camera identity
CR_SITE_ID=S001
CR_CAMERA_ID=cam01
CR_TIMEZONE=UTC

# source
CR_SOURCE_TYPE=rtsp
CR_RTSP_URL=rtsp://127.0.0.1:8554/cam1
CR_SOURCE_LOOP=false

# runtime
CR_FPS_LIMIT=10
CR_MAX_EVENTS=
CR_DRY_RUN=false
CR_OUTPUT_JSONL=

# model
CR_MODEL_TYPE=mock
CR_MODEL_SCORE_THRESHOLD=0.25
CR_YOLO_MODEL_PATH=
CR_ONNX_MODEL_PATH=

# backend
CR_BACKEND_URL=http://127.0.0.1:8080/api/events
CR_BACKEND_TIMEOUT_SEC=2.0

# spool
CR_SPOOL_FILE_PATH=outputs/spool/cam01_pending.jsonl
CR_SPOOL_FLUSH_BATCH=100
