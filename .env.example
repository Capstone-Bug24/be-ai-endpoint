# Runtime identity
CR_SITE_ID=S001
CR_CAMERA_ID=cam01
CR_TIMEZONE=UTC
CR_FPS_LIMIT=10
CR_MAX_EVENTS=

# Source
CR_SOURCE_TYPE=file
CR_FILE_PATH=data/samples/sample.avi
CR_RTSP_URL=
CR_WEBCAM_INDEX=0
CR_SOURCE_LOOP=false

# Model
# mock | yolo | onnx
CR_MODEL_TYPE=mock
CR_MODEL_SCORE_THRESHOLD=0.25
CR_YOLO_MODEL_PATH=
CR_ONNX_MODEL_PATH=

# Output
CR_DRY_RUN=true
CR_OUTPUT_JSONL=
CR_BACKEND_URL=http://127.0.0.1:8080/api/events
CR_BACKEND_TIMEOUT_SEC=2.0

# Durable spool
CR_SPOOL_FILE_PATH=outputs/spool/pending_events.jsonl
CR_SPOOL_FLUSH_BATCH=100
